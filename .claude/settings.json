{
  "_comentario": "Travas da Sociedade (Q174, Q154, C25): push só de ramos de etapa; a main é integrada por merge commit do PR com o 'sim' de Odival na conversa (gh pr merge em ask; squash, rebase, auto e admin em deny). Valem só em sessão com um repositório (documentação do Claude Code, 03/10/2026).",
  "permissions": {
    "ask": [
      "Bash(gh pr merge*)"
    ],
    "deny": [
      "Bash(git push*main*)",
      "Bash(git push*HEAD:refs/heads/main*)",
      "Bash(git push*--force*)",
      "Bash(git push*-f *)",
      "Bash(git push*--delete*)",
      "Bash(git push*--mirror*)",
      "Bash(gh pr merge*--squash*)",
      "Bash(gh pr merge*--rebase*)",
      "Bash(gh pr merge*--auto*)",
      "Bash(gh pr merge*--admin*)",
      "Bash(gh release*)",
      "Bash(gh repo edit*)",
      "Bash(gh repo delete*)",
      "Bash(gh api*-X*protection*)",
      "Bash(gh api*--method*protection*)",
      "Bash(gh api*-X*rulesets*)",
      "Bash(git push*producao*)",
      "Bash(vercel*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
